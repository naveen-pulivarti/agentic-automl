# --- environment -----------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# --- generated datasets ----------------------------------------------------
# Every dataset is downloaded or generated by the two scripts in data/, so the
# files themselves are build output rather than source. Excluding them keeps the
# repository small (they total roughly 60 MB, and Forest Cover Type alone is
# larger than GitHub's recommended per-file limit).
data/*.csv
data/*.db
data/*.xlsx

# --- report working files --------------------------------------------------
# The written report and the running project log are deliberately kept out of
# the repository: their prose overlaps with the submitted document, and a public
# copy could be matched against it by a similarity checker.
docs/
context/

# --- model artefacts -------------------------------------------------------
*.joblib
*.pkl

# --- editor / OS -----------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini

# --- local tooling ---------------------------------------------------------
# Machine-specific launch paths, and the visual guide (a companion document
# whose prose overlaps the report, so it is kept out for the same reason as docs/).
.claude/
Agentic_AutoML_Visual_Guide.docx
